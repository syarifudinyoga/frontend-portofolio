# Vite local development server
VITE_HOST=127.0.0.1
VITE_PORT=3005

# Local Go API; Vite proxies /api requests here during dev
VITE_API_PROXY_TARGET=http://127.0.0.1:3004

# Backend API base URL when frontend and backend use different subdomains
# (e.g. https://api.portfolio.devlabhub.id). If empty, falls back to relative /api/
VITE_API_BASE_URL=

# End-to-end payload encryption secret key (must match backend API_ENCRYPTION_SECRET)
VITE_API_ENCRYPTION_SECRET=portfolio-vault-key-2026-secure-secret-token
