# GitHub username or organization that owns the GHCR package
GHCR_OWNER=your-github-username
IMAGE_NAME=portfolio-web
IMAGE_TAG=latest

# Set this to the backend API address reachable from the frontend container.
# Podman on the same host generally provides host.containers.internal.
API_UPSTREAM=http://host.containers.internal:8080
WEB_PORT=8088
